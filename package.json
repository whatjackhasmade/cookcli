{
	"name": "cook-cli",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "npm run images && next build",
		"dev": "npm run images && next dev --turbopack",
		"fix": "npm run format && npm run lint",
		"format": "npx @biomejs/biome format --write",
		"images": "npx tsx scripts/copyImages.ts",
		"lint": "npx @biomejs/biome lint --write",
		"start": "next start",
		"test": "vitest run"
	},
	"dependencies": {
		"gray-matter": "4.0.3",
		"next": "^16.2.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@cooklang/cooklang": "^0.18.7",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"prettier": "^3.8.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}
