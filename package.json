{
	"name": "cook-cli",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "npm run images && npm run recipes && next build",
		"dev": "npm run images && npm run recipes && concurrently -n recipes,next -c yellow,blue \"npm:dev:recipes\" \"npm:dev:next\"",
		"dev:next": "next dev --turbopack",
		"dev:recipes": "npx tsx watch --clear-screen=false --include \"src/recipes/**/*.cook\" scripts/generateRecipeData.ts",
		"fix": "npm run format && npm run lint",
		"format": "oxfmt",
		"images": "npx tsx scripts/optimizeRecipeImages.ts && npx tsx scripts/copyImages.ts",
		"lint": "oxlint --fix",
		"postinstall": "npx tsx scripts/patchCooklangWasm.ts",
		"recipes": "npx tsx scripts/generateRecipeData.ts",
		"start": "next start",
		"test": "vitest run"
	},
	"dependencies": {
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@cooklang/cooklang": "0.18.7",
		"@types/node": "26.6.6",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"concurrently": "10.0.4",
		"gray-matter": "4.0.3",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"sharp": "0.35.3",
		"tsx": "4.23.10",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
