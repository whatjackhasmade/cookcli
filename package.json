{
	"name": "cook-cli",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "npm run images && next build",
		"dev": "npm run images && next dev --turbopack",
		"fix": "npm run format && npm run lint",
		"format": "npx @biomejs/biome format --write",
		"images": "npx tsx scripts/copyImages.ts",
		"lint": "npx @biomejs/biome lint --write",
		"start": "next start",
		"test": "vitest run"
	},
	"dependencies": {
		"gray-matter": "4.0.3",
		"next": "^16.3.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@cooklang/cooklang": "0.18.7",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"prettier": "^3.9.6",
		"tsx": "^4.23.10",
		"typescript": "^7.0.2",
		"vitest": "4.1.10"
	}
}
