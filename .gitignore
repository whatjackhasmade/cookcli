# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
output.css

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated recipe images (copied from src/recipes at build time)
public/recipes

# minified recipe cover images + cache (regenerated from source .jpg files at build time)
src/recipes/**/*.minified.jpg
scripts/.recipe-image-cache.json

# generated recipe data (parsed from src/recipes at build time)
src/utils/server/generated/
src/utils/server/recipeDataLoaders.generated.ts
src/utils/server/recipeIndex.generated.ts

# jetbrains / local scratch
.idea

# local planning docs
/docs
